[user]
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKWXDakMlZm6oulB8DpgS+0FuZIit2lqgQw8bL6JAVgm

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
{{- if eq .chezmoi.os "darwin" }}
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- end }}

[commit]
  gpgsign = true
[core]
	editor = vim
	# Global dispatcher: secret scan on pre-commit, then hands off to the
	# repo's own hooks and git-lfs (see ~/.config/git/hooks/dispatch).
	hooksPath = ~/.config/git/hooks
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[filter "lfs"]
        clean = git-lfs clean -- %f
        smudge = git-lfs smudge -- %f
        process = git-lfs filter-process
        required = true
[tag]
	gpgSign = true

