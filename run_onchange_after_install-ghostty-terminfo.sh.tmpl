#!/bin/sh
# Remote hosts (e.g. AlmaLinux 9's ncurses 6.2) predate xterm-ghostty, so
# tmux/vim refuse to start over SSH from Ghostty without a local entry.
# The source is inlined rather than deployed so chezmoi never has to manage
# ~/.local/share, whose mode differs between hosts. run_onchange_ re-runs
# this whenever terminfo/xterm-ghostty.terminfo changes. It always compiles:
# skipping when infocmp already knows xterm-ghostty would also skip a copy
# this script installed earlier, so an updated entry would never land.
set -e
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
cat > "$tmp" <<'TERMINFO'
{{ include "terminfo/xterm-ghostty.terminfo" -}}
TERMINFO
# The warning is about tic versions older than any we run; it isn't actionable.
tic -x -o "$HOME/.terminfo" "$tmp" 2>&1 | grep -v 'description field as an alias' >&2 || true
infocmp xterm-ghostty >/dev/null
