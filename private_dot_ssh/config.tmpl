Include config.d/*

Host *
{{- if eq .chezmoi.os "darwin" }}
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
	# Off everywhere except hosts that opt in. config.d is included first and
	# the first value wins, so a host block there can override this.
	ForwardAgent no
	ForwardX11 no
	ForwardX11Trusted no
	# TERM is left alone, so remotes get xterm-ghostty. Every host that runs
	# chezmoi has the entry in ~/.terminfo (see
	# run_onchange_after_install-ghostty-terminfo.sh.tmpl). For a host that
	# doesn't, add this to its Host block in config.d (OpenSSH 8.7+):
	#   SetEnv TERM=xterm-256color

