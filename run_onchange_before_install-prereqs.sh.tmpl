#!/bin/sh
# macOS only: installs the tools these dotfiles reference. run_onchange_ (not
# run_once_) so that editing the package lists below re-runs it on the next
# apply. "before" so 1Password exists before the gitconfig/ssh config that
# depend on it are written. Linux installs nothing (see the else branch).
set -eu

{{ if eq .chezmoi.os "darwin" -}}
# Xcode CLT provides git and clangd (/usr/bin/clangd shim), and Homebrew
# needs it anyway. macOS also ships the tmux-256color terminfo entry (tmux itself is not installed).
if ! xcode-select -p >/dev/null 2>&1; then
    xcode-select --install
    echo "Finish the Xcode Command Line Tools installer, then re-run 'chezmoi apply'." >&2
    exit 1
fi

# Homebrew is not installed for you: that would pipe an unpinned script from
# the network into bash. Install it from https://brew.sh first.
if ! command -v brew >/dev/null 2>&1; then
    echo "install-prereqs: Homebrew not found; install it from https://brew.sh, then re-run 'chezmoi apply'." >&2
    exit 1
fi

# jq parses the Claude Code guard hook's input; gh is wrapped by the guardrails.
brew install git-lfs betterleaks jq gh
# brew refuses to install a cask over an app installed by other means
# (e.g. the 1Password website download), which would abort the apply.
if [ ! -d /Applications/1Password.app ]; then
    brew install --cask 1password
fi
if [ ! -d /Applications/Ghostty.app ]; then
    brew install --cask ghostty
fi

{{ else -}}
# Linux: deliberately installs nothing. Packages (and the login shell) are
# managed outside chezmoi, e.g. by Ansible or by hand; see README Prerequisites.
{{ end -}}
if ! infocmp tmux-256color >/dev/null 2>&1; then
    echo "install-prereqs: tmux-256color terminfo not found; tmux.conf's default-terminal will misbehave." >&2
fi
